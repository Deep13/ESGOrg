<mvc:View controllerName="ESGOrg.ESGOrg.controller.GovernanceAnalytics" xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core" displayBlock="true"
    xmlns:object="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns="sap.m">
    <Page id="page" titleAlignment="Center" showNavButton="true"
        navButtonPress="onpressBack">
        <customHeader>
            <OverflowToolbar>
                <Button icon="sap-icon://navigation-left-arrow" tooltip="Back" press="onpressBack" />
                <Image src="./assets/company_logo.png" class="sapUiMediumMargin"
                    width="90px" />
                <ToolbarSpacer />
                <Title text="Governance Analytics" />
                <ToolbarSpacer />
                <HBox alignItems="Center">
                    <Button icon="sap-icon://log" tooltip="Log Out" press="onLogOut" />
                    <Button icon="sap-icon://headset" tooltip="Support" press="onOpenPopover" />
                </HBox>
            </OverflowToolbar>
        </customHeader>
        <content>
            <object:ObjectPageLayout>
                <object:ObjectPageSection titleUppercase="false" title="Overview">
                    <object:subSections>
                        <object:ObjectPageSubSection titleUppercase="false">
                            <object:blocks>
                                <VBox>
                                    <HBox justifyContent="End">
                                        <Select
                                            class="sapUiSmallMarginEnd"
                                            change="onBranchChange"
                                            id="branchId"
                                            items="{
                        path: 'branchModel>/results'
                    }">
                                            <core:Item key="{branchModel>title}"
                                                text="{branchModel>title}" />
                                        </Select>
                                        <Select
                                            change="onCycleChange"
                                            id="cycleId"
                                            items="{
							path: 'cycleModel>/results'
						}">
                                            <core:Item key="{cycleModel>title}"
                                                text="{cycleModel>title}" />
                                        </Select>
                                    </HBox>
                                    <HBox id="KPIData">
                                    </HBox>
                                    <HBox id="chartData"></HBox>
                                </VBox>
                            </object:blocks>
                        </object:ObjectPageSubSection>
                    </object:subSections>
                </object:ObjectPageSection>
            </object:ObjectPageLayout>
        </content>
        <footer>
            <OverflowToolbar>
                <HBox alignItems="Center" alignContent="Center" justifyContent="Center"
                    width="100%">
                    <Text text="Sustrack Sustainable Solutions Pvt.Ltd © 2024" />
                </HBox>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>