<mvc:View controllerName="ESGOrg.ESGOrg.controller.ESGOverview" xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core" displayBlock="true"
    xmlns:object="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns="sap.m">
    <Page id="page" titleAlignment="Center" showNavButton="true"
        navButtonPress="onpressBack">
        <customHeader>
            <OverflowToolbar>
                <Button icon="sap-icon://navigation-left-arrow" tooltip="Back" press="onpressBack" />
                <Image src="./assets/company_logo.png" class="sapUiMediumMargin"
                    width="90px" />
                <ToolbarSpacer />
                <Title text="ESG Overview" />
                <ToolbarSpacer />
                <HBox alignItems="Center">
                    <Button icon="sap-icon://log" tooltip="Log Out" press="onLogOut" />
                    <Button icon="sap-icon://headset" tooltip="Support" press="onOpenPopover" />
                </HBox>
            </OverflowToolbar>
        </customHeader>
        <content>
            <object:ObjectPageLayout alwaysShowContentHeader="true" class="overview">
                <object:headerContent>
                    <VBox>
                        <HBox id="graphFilters" wrap="Wrap" class="graphFilters-css"></HBox>
                    </VBox>
                </object:headerContent>
                <object:ObjectPageSection titleUppercase="false" title="Environment">
                    <object:subSections>
                        <object:ObjectPageSubSection titleUppercase="false">
                            <object:blocks>
                                <HBox wrap="Wrap">
                                    <VBox id="KPIData" wrap="Wrap">
                                    </VBox>
                                    <HBox id="chartData" justifyContent="Center">
                                        <layoutData>
                                            <FlexItemData growFactor="1" />
                                        </layoutData>
                                    </HBox>

                                </HBox>
                            </object:blocks>
                        </object:ObjectPageSubSection>
                    </object:subSections>
                </object:ObjectPageSection>
                <object:ObjectPageSection titleUppercase="false" title="Social">
                    <object:subSections>
                        <object:ObjectPageSubSection titleUppercase="false">
                            <object:blocks>
                                <HBox>

                                    <VBox id="KPIDataSocial" wrap="Wrap">
                                    </VBox>
                                    <HBox id="chartDataSocial" justifyContent="Center">
                                        <layoutData>
                                            <FlexItemData growFactor="1" />
                                        </layoutData>
                                    </HBox>
                                </HBox>
                            </object:blocks>
                        </object:ObjectPageSubSection>
                    </object:subSections>
                </object:ObjectPageSection>
                <object:ObjectPageSection titleUppercase="false" title="Governance">
                    <object:subSections>
                        <object:ObjectPageSubSection titleUppercase="false">
                            <object:blocks>
                                <HBox>

                                    <VBox id="KPIDataGovernance" wrap="Wrap">
                                    </VBox>
                                    <HBox id="chartDataGovernance" justifyContent="Center">
                                        <layoutData>
                                            <FlexItemData growFactor="1" />
                                        </layoutData>
                                    </HBox>
                                </HBox>
                            </object:blocks>
                        </object:ObjectPageSubSection>
                    </object:subSections>
                </object:ObjectPageSection>
            </object:ObjectPageLayout>
        </content>
        <footer>
            <OverflowToolbar>
                <HBox alignItems="Center" alignContent="Center" justifyContent="Center"
                    width="100%">
                    <Text text="{i18n>footer}" />
                </HBox>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>