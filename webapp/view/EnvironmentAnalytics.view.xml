<mvc:View controllerName="ESGOrg.ESGOrg.controller.EnvironmentAnalytics" xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core" displayBlock="true"
    xmlns:object="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns="sap.m">
    <Page id="page" titleAlignment="Center" showNavButton="true"
        navButtonPress="onpressBack">
        <customHeader>
            <OverflowToolbar>
                <Button icon="sap-icon://navigation-left-arrow" tooltip="Back" press="onpressBack" />
                <Image src="./assets/company_logo.png" class="sapUiMediumMargin"
                    width="90px" />
                <ToolbarSpacer />
                <Title text="Environment Analytics" />
                <ToolbarSpacer />
                <HBox alignItems="Center">
                    <Button icon="sap-icon://log" tooltip="Log Out" press="onLogOut" />
                    <Button icon="sap-icon://headset" tooltip="Support" press="onOpenPopover" />
                </HBox>
            </OverflowToolbar>
        </customHeader>
        <content>
            <object:ObjectPageLayout>
                <object:headerContent>
                    <VBox>
                        <HBox id="graphFilters" wrap="Wrap" class="graphFilters-css"></HBox>
                    </VBox>
                </object:headerContent>
                <object:ObjectPageSection titleUppercase="false" title="Overview">
                    <object:subSections>
                        <object:ObjectPageSubSection titleUppercase="false">
                            <object:blocks>
                                <VBox>

                                    <HBox id="KPIData" wrap="Wrap">
                                    </HBox>
                                    <HBox id="chartData"></HBox>
                                </VBox>
                            </object:blocks>
                        </object:ObjectPageSubSection>
                    </object:subSections>
                </object:ObjectPageSection>
                <object:ObjectPageSection titleUppercase="false" title="Scope 1">
                    <object:subSections>
                        <object:ObjectPageSubSection titleUppercase="false">
                            <object:blocks>
                                <VBox>
                                    <HBox id="KPIDataScope1" wrap="Wrap">
                                    </HBox>
                                    <HBox id="chartDataScope1"></HBox>
                                </VBox>
                            </object:blocks>
                        </object:ObjectPageSubSection>
                    </object:subSections>
                </object:ObjectPageSection>
                <object:ObjectPageSection titleUppercase="false" title="Scope 2">
                    <object:subSections>
                        <object:ObjectPageSubSection titleUppercase="false">
                            <object:blocks>
                                <VBox>
                                    <HBox id="KPIDataScope2" wrap="Wrap">
                                    </HBox>
                                    <HBox id="chartDataScope2"></HBox>
                                </VBox>
                            </object:blocks>
                        </object:ObjectPageSubSection>
                    </object:subSections>
                </object:ObjectPageSection>
                <object:ObjectPageSection titleUppercase="false" title="Scope 3">
                    <object:subSections>
                        <object:ObjectPageSubSection titleUppercase="false">
                            <object:blocks>
                                <VBox>
                                    <HBox id="KPIDataScope3" wrap="Wrap">
                                    </HBox>
                                    <HBox id="chartDataScope3"></HBox>
                                </VBox>
                            </object:blocks>
                        </object:ObjectPageSubSection>
                    </object:subSections>
                </object:ObjectPageSection>
            </object:ObjectPageLayout>
        </content>
        <footer>
            <OverflowToolbar>
                <HBox alignItems="Center" alignContent="Center" justifyContent="Center"
                    width="100%">
                    <Text text="{i18n>footer}" />
                </HBox>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>