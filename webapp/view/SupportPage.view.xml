<mvc:View
    controllerName="ESGOrg.ESGOrg.controller.SupportPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:object="sap.uxap"
    xmlns="sap.m">
    <Page id="page" titleAlignment="Center" showNavButton="true"
        navButtonPress="onpressBack">
        <customHeader>
            <OverflowToolbar>
                <Button icon="sap-icon://navigation-left-arrow" tooltip="Back" press="onpressBack" />
                <Image src="./assets/company_logo.png" class="sapUiMediumMargin"
                    width="90px" />
                <ToolbarSpacer />
                <Title text="Incident Tickets" />
                <ToolbarSpacer />
                <HBox alignItems="Center">
                    <Button icon="sap-icon://log" tooltip="Log Out" press="onLogOut" />
                    <Button icon="sap-icon://headset" tooltip="Support" press="onOpenPopover" />
                </HBox>
            </OverflowToolbar>
        </customHeader>
        <content>
            <HBox alignItems="End" class="sapUiSmallMargin">
                <!-- Branch Filter -->


                <!-- Status Filter -->
                <VBox class="sapUiSmallMarginEnd">
                    <Label text="Priority" labelFor="priorityFilter" />
                    <ComboBox id="priorityFilter" selectionChange="onPriorityFilter"
                        selectedKey="All">
                        <core:Item key="All" text="All" />
                        <core:Item key="Low" text="Low" />
                        <core:Item key="Medium" text="Medium" />
                        <core:Item key="High" text="High" />
                    </ComboBox>
                </VBox>
                <VBox class="sapUiSmallMarginEnd">
                    <Label text="Status" labelFor="statusFilter" />
                    <ComboBox id="statusFilter" selectionChange="onStatusFilter"
                        selectedKey="All">
                        <core:Item key="All" text="All" />
                        <core:Item key="New" text="New" />
                        <core:Item key="In Progress" text="In Progress" />
                        <core:Item key="On Hold" text="On Hold" />
                        <core:Item key="Resolved" text="Resolved" />
                    </ComboBox>
                </VBox>

                <!-- Reset Filters Button -->
                <VBox>
                    <Button text="Reset Filters" press="onResetFilters" />
                </VBox>
            </HBox>

            <!-- Table for displaying branch/module data -->
            <Table id="branchTable" items="{/results}">
                <!-- Column Definitions -->
                <columns>
                    <Column>
                        <Text text="Incident Id" />
                    </Column>
                    <Column>
                        <Text text="Email" />
                    </Column>
                    <Column>
                        <Text text="Phone" />
                    </Column>
                    <Column>
                        <Text text="Title" />
                    </Column>
                    <Column>
                        <Text text="Description" />
                    </Column>
                    <Column>
                        <Text text="Created Date" />
                    </Column>
                    <Column>
                        <Text text="Status" />
                    </Column>
                    <Column>
                        <Text text="Priority" />
                    </Column>
                </columns>

                <!-- Binding Data for Each Row -->
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{incidentID}" />
                            <Text text="{email}" />
                            <Text text="{phone}" />
                            <Text text="{title}" />
                            <Text text="{description}" />
                            <Text text="{createdDate}" />
                            <Text text="{status}" />
                            <ObjectStatus text="{priority}"
                                inverted="true"
                                state="{=${priority} === 'Low' ? 'Indication03' : ${priority} === 'Medium' ? 'Indication02':'Indication01'}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            <!-- <object:ObjectPageLayout id="objectPageLayout">
            </object:ObjectPageLayout> -->
        </content>
        <footer>
            <OverflowToolbar>
                <HBox alignItems="Center" alignContent="Center" justifyContent="Center"
                    width="100%">
                    <Text text="{i18n>footer}" />
                </HBox>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>